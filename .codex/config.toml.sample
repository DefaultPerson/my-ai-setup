# Codex CLI configuration
# Merge into ~/.codex/config.toml; choose a model with /model.

model_reasoning_effort = "high"
approval_policy = "on-request"

[features]
apps = false
tool_suggest = false

[tui]
# Configure interactively with /statusline.
status_line_use_colors = true
status_line = [
  "current-dir",
  "git-branch",
  "pull-request-number",
  "branch-changes",
  "model-with-reasoning",
  "context-remaining",
  "task-progress",
]

[shell_environment_policy]
inherit = "core"

# Trust the PreToolUse hook through /hooks after merging hooks.json.
